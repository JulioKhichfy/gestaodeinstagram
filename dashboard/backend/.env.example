# Copie para .env e preencha. Veja dashboard/SETUP.md.

# App da Meta > Instagram > "API setup with Instagram login" (Instagram App ID / Secret)
IG_APP_ID=
IG_APP_SECRET=

# Descoberta de perfis (opcional): login do Facebook do MESMO app da Meta.
# Pegue em Configurações do app > Básico (ID do app / Chave secreta do app). Não são os do Instagram.
FB_APP_ID=
FB_APP_SECRET=
# Retorno do login do Facebook. Vazio = http://localhost:3000 (a Meta aceita localhost em modo Desenvolvimento).
# FB_REDIRECT_BASE=

# Endereço HTTPS público do túnel (ngrok) que aponta para este backend (porta abaixo).
# Ex.: https://seu-nome.ngrok-free.app  (sem barra no final)
PUBLIC_BASE_URL=

# Onde o Angular roda no seu PC
FRONTEND_URL=http://localhost:4300

PORT=3000

# Versão da Graph API. Versões expiram ~2 anos após o lançamento; atualize se a Meta avisar.
GRAPH_API_VERSION=v23.0

# Claude Code (assinatura). Deixe em branco para usar o padrão.
# CLAUDE_BIN=claude
# CLAUDE_MODEL=
